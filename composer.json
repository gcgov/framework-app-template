{
	"name": "gcgov/framework-app-template",
	"description": "App template repository to scaffold a new application based on gcgov/framework.",
	"require": {
		"php": ">=8.4",
		"ext-mongodb": "*",
		"mongodb/mongodb": "^2.1",
		"phpmailer/phpmailer": "^6.2",
		"zircote/swagger-php": "^6.1",
		"gcgov/framework": "^7.0@RC",
		"gcgov/framework-service-gcgov-cron-monitor": "^v1.1",
		"gcgov/framework-service-documentation": "^1.1",
		"gcgov/framework-service-auth-oauth-server": "^2.1",
		"gcgov/framework-service-user-crud": "^1.1"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^11.5",
		"jetbrains/phpstorm-attributes": "^1.0"
	},
	"config": {
		"platform": {
			"php": "8.4.0"
		}
	},
	"autoload": {
		"psr-4": {
			"app\\": "app/"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse --memory-limit=512M",
		"test": "phpunit",
		"ci": [
			"@phpstan",
			"@test"
		]
	}
}
